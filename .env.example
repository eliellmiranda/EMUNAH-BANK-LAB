# Copie este arquivo para .env e preencha os valores antes de rodar o ebops_server.py
# O arquivo .env NUNCA deve ser commitado no git.

# Porta do servidor Flask (padrão: 5000)
EBOPS_PORT=5000

# Caminho raiz do projeto EMUNAH-BANK-LAB (usado pelo ebops.py para localizar datasets)
# Exemplo Windows: C:\Users\seu-usuario\EMUNAH-BANK-LAB
# Exemplo Linux/Mac: /home/seu-usuario/EMUNAH-BANK-LAB
EMUNAH_ROOT=
