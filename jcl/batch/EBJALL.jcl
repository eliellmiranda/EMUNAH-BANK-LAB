//* ============================================================
//* ARQUIVO      : EBJALL.jcl
//* CAMINHO LOCAL: jcl/batch/EBJALL.jcl
//* HOST / PDS   : Z77948.EMUNAH.DEV.JCL(EBJALL)
//*
//* FINALIDADE:
//* Executa a cadeia batch diaria completa em um unico job,
//* substituindo a submissao individual dos 14 jobs do ciclo.
//* Util para testes de lab, rerun completo e treinamento.
//*
//* CADEIA EXECUTADA (em ordem):
//*  1. EBJPRECK  - Pre-check do ambiente (5 steps)
//*  2. EBJSOD    - Start of Day -> CTL.STATUS = OPEN
//*  3. EBJBCKPD  - Backup das bases em GDG
//*  4. EBJWAIT   - Verifica STAGE.ENTRADA.SEQ presente e nao vazio
//*  5. EBJLOAD   - Carga STAGE -> ARQ.ENTRADA.SEQ
//*  6. EBJVALD   - Validacao de lancamentos (RC 4 = tem rejeitos)
//*  7. EBJPOST   - Postagem dos validos no CONTA.KSDS
//*  8. EBJCUTF   - Corte financeiro -> CTL.STATUS = EOTI
//*  9. EBJACCR   - Calculo de accruals (juros e tarifas)
//* 10. EBJCUTE   - Corte contabil -> CTL.STATUS = EOFI
//* 11. EBJSNAP   - Snapshot de saldos -> ARQ.SALDO.GDG(+1)
//* 12. EBJCONC   - Conciliacao tres-vias
//* 13. EBJEXTR   - Geracao de extrato -> ARQ.EXTRATO.GDG(+1)
//* 14. EBJEOD    - End of Day -> CTL.STATUS = CLOSED
//*
//* LOGICA DE COND:
//* COND=(4,GT) em todos os steps: encadeia se RC <= 4.
//* RC 0  = sucesso total.
//* RC 4  = aviso aceitavel (ex: rejeitos, vazio).
//* RC 8+ = erro grave — steps seguintes sao ignorados.
//*
//* OBSERVACAO SOBRE NOMES DE STEPS:
//* Como todos os steps residem em um unico job, os nomes foram
//* prefixados para evitar conflito (ex: CHKSTAT vira LDSTAT,
//* VLSTAT, PSSTAT etc., conforme o job de origem).
//* ============================================================
//EBJALL   JOB ,'EMUNAH ALL',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*
//* ============================================================
//* SECAO 1: EBJPRECK — PRE-CHECK DO AMBIENTE
//* ============================================================
//*
//PRCKLOAD EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.DEV.LOADLIB') ALL
  IF LASTCC > 0 THEN -
    SET MAXCC = 12
/*
//*
//PRCKCOPY EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.DEV.COPY') ALL
  IF LASTCC > 0 THEN -
    SET MAXCC = 12
/*
//*
//PRCKCLI  EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.ARQ.CLIENTE.KSDS') ALL
  IF LASTCC > 0 THEN -
    SET MAXCC = 12
/*
//*
//PRCKCNT  EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.ARQ.CONTA.KSDS') ALL
  IF LASTCC > 0 THEN -
    SET MAXCC = 12
/*
//*
//PRCKCTL  EXEC PGM=EBCTL01,PARM='CHK,CLOSED',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//* ============================================================
//* SECAO 2: EBJSOD — START OF DAY (CTL.STATUS = OPEN)
//* ============================================================
//*
//SODWRTS  EXEC PGM=EBCTL01,PARM='UPD,OPEN',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=OLD
//*
//* ============================================================
//* SECAO 3: EBJBCKPD — BACKUP DAS BASES
//* Nota: BKPCNC pode retornar RC > 0 na primeira execucao do dia
//* se ARQ.CONCIL.SEQ ainda nao existir do ciclo anterior.
//* ============================================================
//*
//BKPCLI   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=Z77948.EMUNAH.ARQ.CLIENTE.KSDS,DISP=SHR
//OUTFILE  DD DSN=Z77948.EMUNAH.BKP.CLIENTE.GDG(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
//*
//BKPCNT   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//OUTFILE  DD DSN=Z77948.EMUNAH.BKP.CONTA.GDG(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
//*
//BKPAUD   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=SHR
//OUTFILE  DD DSN=Z77948.EMUNAH.BKP.AUDIT.GDG(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5)),
//            LIKE=Z77948.EMUNAH.ARQ.AUDIT.SEQ
//SYSIN    DD *
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
//*
//BKPREJ   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=Z77948.EMUNAH.ARQ.REJEITOS.SEQ,DISP=SHR
//OUTFILE  DD DSN=Z77948.EMUNAH.BKP.REJEITOS.GDG(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            LIKE=Z77948.EMUNAH.ARQ.REJEITOS.SEQ
//SYSIN    DD *
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
//*
//BKPCNC   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=Z77948.EMUNAH.ARQ.CONCIL.SEQ,DISP=SHR
//OUTFILE  DD DSN=Z77948.EMUNAH.BKP.CONCIL.GDG(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5)),
//            LIKE=Z77948.EMUNAH.ARQ.CONCIL.SEQ
//SYSIN    DD *
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
//*
//* ============================================================
//* SECAO 4: EBJWAIT — FILE-WATCHER DO STAGE
//* ============================================================
//*
//WTEXST   EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.STAGE.ENTRADA.SEQ') ALL
/*
//*
//WTCNT    EXEC PGM=ICETOOL,COND=(4,GT)
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//STAGE    DD DSN=Z77948.EMUNAH.STAGE.ENTRADA.SEQ,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(STAGE) EMPTY
/*
//*
//* ============================================================
//* SECAO 5: EBJLOAD — CARGA DO STAGING PARA ARQ DO DIA
//* ============================================================
//*
//LDSTAT   EXEC PGM=EBCTL01,PARM='CHK,OPEN',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//LDDEL    EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE 'Z77948.EMUNAH.ARQ.ENTRADA.SEQ' NONVSAM
  SET MAXCC = 0
/*
//*
//LDCOPY   EXEC PGM=IEBGENER,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=Z77948.EMUNAH.STAGE.ENTRADA.SEQ,DISP=SHR
//SYSUT2   DD DSN=Z77948.EMUNAH.ARQ.ENTRADA.SEQ,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSIN    DD DUMMY
//*
//LDVFY    EXEC PGM=IDCAMS,COND=(4,GT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('Z77948.EMUNAH.ARQ.ENTRADA.SEQ') ALL
  IF LASTCC > 0 THEN -
    SET MAXCC = 12
/*
//*
//* ============================================================
//* SECAO 6: EBJVALD — VALIDACAO DE LANCAMENTOS
//* RC 4 = ha rejeitos (aceitavel — cadeia continua)
//* ============================================================
//*
//VLSTAT   EXEC PGM=EBCTL01,PARM='CHK,OPEN',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//VLVALI   EXEC PGM=EBVALI01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//ENTRADA  DD DSN=Z77948.EMUNAH.ARQ.ENTRADA.SEQ,DISP=SHR
//VALIDOS  DD DSN=Z77948.EMUNAH.ARQ.LANCTO.ESDS,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//REJEITOS DD DSN=Z77948.EMUNAH.ARQ.REJEITOS.SEQ,
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=156,BLKSIZE=0)
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,
//             DISP=(MOD,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(10,5)),
//             DCB=(RECFM=FB,LRECL=128,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 7: EBJPOST — POSTAGEM NOS SALDOS
//* RC 4 = algum lancamento rejeitado por saldo insuficiente
//* ============================================================
//*
//PSSTAT   EXEC PGM=EBCTL01,PARM='CHK,OPEN',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//PSPOSTA  EXEC PGM=EBPOST01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//MOVTIN   DD DSN=Z77948.EMUNAH.ARQ.LANCTO.ESDS,DISP=SHR
//CLIENTE  DD DSN=Z77948.EMUNAH.ARQ.CLIENTE.KSDS,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=MOD
//REJEITOS DD DSN=Z77948.EMUNAH.ARQ.REJEITOS.SEQ,DISP=MOD
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 8: EBJCUTF — CORTE FINANCEIRO (CTL.STATUS = EOTI)
//* ============================================================
//*
//CFWRTS   EXEC PGM=EBCTL01,PARM='UPD,EOTI',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=OLD
//*
//* ============================================================
//* SECAO 9: EBJACCR — CALCULO DE ACCRUALS
//* ============================================================
//*
//ACSTAT   EXEC PGM=EBCTL01,PARM='CHK,EOTI',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//ACACCR   EXEC PGM=EBACCR01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//PARMLIB  DD DSN=Z77948.EMUNAH.PARM.JUROS.CONFIG(EBJUROSP),DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//ACCROUT  DD DSN=Z77948.EMUNAH.ARQ.ACCR.MOV.SEQ,DISP=SHR
//LANCTO   DD DSN=Z77948.EMUNAH.ARQ.LANCTO.ESDS,DISP=SHR
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=MOD
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 10: EBJCUTE — CORTE CONTABIL (CTL.STATUS = EOFI)
//* ============================================================
//*
//CEWRTS   EXEC PGM=EBCTL01,PARM='UPD,EOFI',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=OLD
//*
//* ============================================================
//* SECAO 11: EBJSNAP — SNAPSHOT DE SALDOS
//* ============================================================
//*
//SNSNAP   EXEC PGM=EBSNAP01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//SALDOUT  DD DSN=Z77948.EMUNAH.ARQ.SALDO.GDG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=MOD
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 12: EBJCONC — CONCILIACAO TRES-VIAS
//* ============================================================
//*
//CNSTAT   EXEC PGM=EBCTL01,PARM='CHK,EOFI',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//CNCNCL   EXEC PGM=EBCONC01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//ENTRIN   DD DSN=Z77948.EMUNAH.ARQ.ENTRADA.SEQ,DISP=SHR
//MOVTIN   DD DSN=Z77948.EMUNAH.ARQ.LANCTO.ESDS,DISP=SHR
//REJEIT   DD DSN=Z77948.EMUNAH.ARQ.REJEITOS.SEQ,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//SALDOIN  DD DSN=Z77948.EMUNAH.ARQ.SALDO.GDG(0),DISP=SHR
//CONCOUT  DD DSN=Z77948.EMUNAH.ARQ.CONCIL.SEQ,DISP=SHR
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=MOD
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 13: EBJEXTR — GERACAO DE EXTRATO
//* ============================================================
//*
//EXEXTR   EXEC PGM=EBEXTR01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//MOVTIN   DD DSN=Z77948.EMUNAH.ARQ.LANCTO.ESDS,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//EXTROUT  DD DSN=Z77948.EMUNAH.ARQ.EXTRATO.GDG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(10,5)),
//             DCB=(RECFM=FB,LRECL=132,BLKSIZE=1320)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//* ============================================================
//* SECAO 14: EBJEOD — END OF DAY (CTL.STATUS = CLOSED)
//* ============================================================
//*
//EDSTAT   EXEC PGM=EBCTL01,PARM='CHK,EOFI',COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=SHR
//*
//EDFECHT  EXEC PGM=EBJEOD01,COND=(4,GT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//CONCIN   DD DSN=Z77948.EMUNAH.ARQ.CONCIL.SEQ,DISP=SHR
//CONTA    DD DSN=Z77948.EMUNAH.ARQ.CONTA.KSDS,DISP=SHR
//SALDOIN  DD DSN=Z77948.EMUNAH.ARQ.SALDO.GDG(0),DISP=SHR
//FECHOUT  DD DSN=Z77948.EMUNAH.ARQ.FECHTO.SEQ,DISP=OLD
//AUDIT    DD DSN=Z77948.EMUNAH.ARQ.AUDIT.SEQ,DISP=MOD
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//EDCLOS   EXEC PGM=EBCTL01,PARM='UPD,CLOSED',COND=(0,NE,EDFECHT)
//STEPLIB  DD DSN=Z77948.EMUNAH.DEV.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLSTAT  DD DSN=Z77948.EMUNAH.ARQ.CTL.STATUS,DISP=OLD
//*
